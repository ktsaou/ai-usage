# === Z.AI (GLM Coding Plan) ===
ZAI_API_KEY=

# === MiniMax (Token Plan / Coding Plan) ===
# Set REGION to "cn" if using Chinese platform (minimaxi.com), otherwise "intl"
MINIMAX_REGION=intl
MINIMAX_SUBSCRIPTION_KEY=

# === Kimi (Coding Plan) ===
# Must be sk-kimi-xxx format (NOT the regular sk-xxx from platform.kimi.ai)
KIMI_CODING_API_KEY=

# === Deployment ===
# Host running the daemon, used by `npm run sync:profile` (ssh name or address).
AI_USAGE_REMOTE=

# === Branding ===
# Shown on the dashboard and used as the MCP server name. Kept out of the
# committed config so deployments do not publish an internal endpoint name.
# Defaults to "ai-usage" when unset.
AI_USAGE_SERVICE_NAME=
AI_USAGE_SERVICE_TAGLINE=models remaining usage

# === MiMo (Xiaomi) and Alibaba Cloud (Coding / Token Plan) ===
# No keys here: these three have no usable API key and are polled through a
# logged-in browser profile. Run `npm run login` on a desktop, then
# `npm run sync:profile`. See CREDS.md.

# === DeepSeek (pay-per-use balance) ===
DEEPSEEK_API_KEY=
